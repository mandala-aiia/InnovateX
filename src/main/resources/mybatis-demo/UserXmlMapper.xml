<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alec.InnovateX.spring.mybatis.UserXmlMapper">

    <!-- 二级缓存开关：跨 SqlSession 生效（默认序列化存储，要求实体 Serializable）；
         本 Mapper 的写操作会自动清空缓存 -->
    <cache/>

    <select id="selectById" resultType="com.alec.InnovateX.spring.mybatis.User">
        select id, username, email
        from mb_user
        where id = #{id}
    </select>

    <!-- 动态 SQL：<where> 自动处理开头的 and，<if> 按参数是否为空拼装条件 -->
    <select id="selectByCondition" resultType="com.alec.InnovateX.spring.mybatis.User">
        select id, username, email
        from mb_user
        <where>
            <if test="username != null and username != ''">
                and username like ('%' || #{username} || '%')
            </if>
            <if test="emailLike != null and emailLike != ''">
                and email like ('%' || #{emailLike} || '%')
            </if>
        </where>
        order by id
    </select>

    <!-- 动态 SQL：<foreach> 拼批量插入的 values 列表 -->
    <insert id="insertBatch">
        insert into mb_user (username, email) values
        <foreach collection="users" item="u" separator=",">
            (#{u.username}, #{u.email})
        </foreach>
    </insert>

</mapper>
