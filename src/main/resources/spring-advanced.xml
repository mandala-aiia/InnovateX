<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:util="http://www.springframework.org/schema/util"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/util http://www.springframework.org/schema/util/spring-util.xsd">

    <!-- ========== 1. bean 继承：abstract=true 的父定义只是模板，不会被实例化 ========== -->
    <bean id="xmlParent" abstract="true">
        <property name="name" value="父类默认名"/>
        <property name="shared" value="父类公共属性"/>
    </bean>
    <bean id="xmlChild" class="com.alec.InnovateX.spring.xmladvanced.XmlChildBean" parent="xmlParent">
        <!-- 子定义覆盖父定义的同名属性 -->
        <property name="name" value="子类覆盖名"/>
    </bean>
    <!-- alias：为 xmlChild 增加别名 -->
    <alias name="xmlChild" alias="xmlChildAlias"/>

    <!-- ========== 2. 静态工厂方法：factory-method 指向静态方法 ========== -->
    <bean id="fromStaticFactory"
          class="com.alec.InnovateX.spring.xmladvanced.XmlStaticFactory"
          factory-method="create"/>

    <!-- ========== 3. 实例工厂：先建工厂 Bean，再由它产出目标 Bean ========== -->
    <bean id="xmlInstanceFactory" class="com.alec.InnovateX.spring.xmladvanced.XmlInstanceFactory"/>
    <bean id="fromInstanceFactory"
          class="com.alec.InnovateX.spring.xmladvanced.XmlFactoryProduct"
          factory-bean="xmlInstanceFactory"
          factory-method="build"/>

    <!-- ========== 4. lookup-method：单例依赖多例（容器用 CGLIB 动态实现抽象方法） ========== -->
    <bean id="xmlSoldier" class="com.alec.InnovateX.spring.xmladvanced.XmlSoldier" scope="prototype"/>
    <bean id="xmlCommander" class="com.alec.InnovateX.spring.xmladvanced.XmlCommander">
        <lookup-method name="createSoldier" bean="xmlSoldier"/>
    </bean>

    <!-- ========== 5. replaced-method：运行时整体替换方法实现 ========== -->
    <bean id="xmlWorkerReplacer" class="com.alec.InnovateX.spring.xmladvanced.XmlWorkerReplacer"/>
    <bean id="xmlOriginalWorker" class="com.alec.InnovateX.spring.xmladvanced.XmlOriginalWorker">
        <replaced-method name="work" replacer="xmlWorkerReplacer"/>
    </bean>

    <!-- ========== 6. 集合注入：map/set/props（list 见 spring-context.xml 的既有示例） ========== -->
    <bean id="xmlCollections" class="com.alec.InnovateX.spring.xmladvanced.XmlCollectionsBean">
        <property name="map">
            <map>
                <entry key="one" value="1"/>
                <entry key="child" value-ref="xmlChild"/>
            </map>
        </property>
        <property name="set">
            <set>
                <value>a</value>
                <value>b</value>
            </set>
        </property>
        <property name="props">
            <props>
                <prop key="k">v</prop>
            </props>
        </property>
        <property name="utilList" ref="utilListBean"/>
        <property name="utilMap" ref="utilMapBean"/>
    </bean>

    <!-- util: 命名空间：把集合本身定义为独立 Bean，可复用、可被引用 -->
    <util:list id="utilListBean">
        <value>x</value>
        <value>y</value>
    </util:list>
    <util:map id="utilMapBean">
        <entry key="key" value="value"/>
    </util:map>

    <!-- ========== 7. lazy-init：refresh 时不实例化，第一次 getBean 才创建 ========== -->
    <bean id="xmlLazyBean" class="com.alec.InnovateX.spring.xmladvanced.XmlLazyBean" lazy-init="true"/>

    <!-- ========== 8. autowire=byName：按 setter 名自动装配（setter 名去 set 后首字母小写 = bean 名称） ========== -->
    <bean id="xmlFactoryProduct" class="com.alec.InnovateX.spring.xmladvanced.XmlFactoryProduct"
          factory-bean="xmlInstanceFactory" factory-method="build"/>
    <bean id="xmlAutowireClient" class="com.alec.InnovateX.spring.xmladvanced.XmlAutowireClient" autowire="byName"/>

</beans>
